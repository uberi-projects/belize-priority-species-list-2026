# .gitignore

# BirdLife/IUCN bird range map shapefiles -----------------------------------------
/birdlife_ranges/*
!/birdlife_ranges/.gitkeep
!/birdlife_ranges/README.md

# Belize boundary data -----------------------------------------
/basemap/*
!/basemap/.gitkeep
!/basemap/README.md

# Outputs are tracked in this forked repository -----------------------------------------

# R environment variables -----------------------------------------
.Renviron

# R session/history files -----------------------------------------
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata

# RStudio -----------------------------------------
.Rproj.user/